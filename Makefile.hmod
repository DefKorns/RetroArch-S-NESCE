MOD_ID       := retroarch_snesce
MOD_NAME     := RetroArch (S)NESCE
MOD_CATEGORY := RetroArch
MOD_DIR      := classicmini/mod
LIBRETRO_DIR := classicmini/mod/etc/libretro
MOD_DEPS     := classicmini/mod/bin/retroarch classicmini/mod/bin/fbgrab classicmini/mod/bin/retroarch_watchdog $(LIBRETRO_DIR)/assets/ozone/regular.ttf $(LIBRETRO_DIR)/joypad_autoconf/udev/Sony-PlayStation3-DualShock3-Controller-USB.cfg

all: hmod

classicmini/mod/bin/retroarch:
	sh classicmini/build_retroarch.sh $@

classicmini/mod/bin/fbgrab:
	sh classicmini/build_fbgrab.sh $@

$(LIBRETRO_DIR)/assets/ozone/regular.ttf:
	sh classicmini/fetch_assets.sh $(LIBRETRO_DIR)

$(LIBRETRO_DIR)/joypad_autoconf/udev/Sony-PlayStation3-DualShock3-Controller-USB.cfg: $(LIBRETRO_DIR)/assets/ozone/regular.ttf

classicmini/mod/bin/retroarch_watchdog: classicmini/src/retroarch_watchdog.c
	$(CROSS_PREFIX)gcc -std=gnu99 -O2 -Wall -o $@ $<
	$(CROSS_PREFIX)strip $@

clean:
	rm -rf out/ classicmini/mod/bin/retroarch classicmini/mod/bin/fbgrab classicmini/mod/bin/retroarch_watchdog $(LIBRETRO_DIR)/assets $(LIBRETRO_DIR)/joypad_autoconf
	$(MAKE) -f Makefile clean

include vendor/hmod-build/hmod.mk

.PHONY: all clean
