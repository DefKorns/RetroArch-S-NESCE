#!/bin/sh

uistop
self="$(readlink -f "$0")"

if [ -f "/bin/remote-exec" ]; then
  if [ "$1" = "--rexec" ]; then
    shift
	rexec_ok="1"
  else
    echo "$self --rexec $*" > /var/exec.flag
    exit 1
  fi
fi

HOME="/etc/libretro"
rcache="/var/cache/retroarch"
mkdir -p "$rcache"

[ -f "$HOME/retroarch.cfg" ] || cp "$HOME/config/retroarch_default.cfg" "$HOME/retroarch.cfg"

autoSaves(){
  sed -i "s|^savestate_auto_load .*|savestate_auto_load = \"$1\"|; s|^savestate_auto_save .*|savestate_auto_save = \"$1\"|" "$HOME/retroarch.cfg"
}

autoSaves false

if [ "$1" = "null" ]; then
  retroarch -c "$HOME/retroarch.cfg" -vf &
else
  core="$HOME/core/${1}_libretro.so"
  shift
  retroarch -c "$HOME/retroarch.cfg" -vfL "$core" ${1+"$@"} &
fi
rpid="$!"

if [ -n "$rexec_ok" ]; then
  retroarch_watchdog --pid "$rpid" | while read -r _ button value _; do
    case "$button $value" in
      "home 1"|"reset 1"|"power 0") kill "$rpid" ;;
    esac
  done
fi

autoSaves true

wait "$rpid"
rm -rf "$rcache"
uistart
