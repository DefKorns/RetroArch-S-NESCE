# Stand-in for retroarch_watchdog: prints $WD_OUTPUT.
echo "watchdog $*" | sed 's/[0-9][0-9]*$/PID/' >> /tmp/log.watchdog
if [ -n "$WD_OUTPUT" ]; then
  sleep 1
  printf '%s\n' "$WD_OUTPUT"
fi
exit 0
